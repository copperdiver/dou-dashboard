# Фоновые задачи (сервисы worker и migrate). Запускается через tsx —
# отдельная сборка TypeScript не нужна, tsx лежит в dependencies.
FROM node:24-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# --omit=dev: drizzle-kit и типы в рантайме воркера не нужны.
RUN npm ci --omit=dev

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY drizzle ./drizzle
COPY src ./src

RUN addgroup -g 1001 -S nodejs \
 && adduser -S worker -u 1001 \
 && chown -R worker:nodejs /app
USER worker

# Напрямую через tsx, без обёртки npm: чище логи и корректная передача SIGTERM.
CMD ["./node_modules/.bin/tsx", "src/worker/index.ts"]
