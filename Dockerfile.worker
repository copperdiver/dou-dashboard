# Background jobs (worker and migrate services). Runs via tsx: no
# separate TypeScript build needed, tsx is a regular dependency.
FROM node:24-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# --omit=dev: drizzle-kit and type packages aren't needed at worker runtime.
RUN npm ci --omit=dev

FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production

COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY drizzle ./drizzle
COPY src ./src

RUN addgroup -g 1001 -S nodejs \
 && adduser -S worker -u 1001 \
 && chown -R worker:nodejs /app
USER worker

# Runs tsx directly, no npm wrapper: cleaner logs and SIGTERM passes through correctly.
CMD ["./node_modules/.bin/tsx", "src/worker/index.ts"]
