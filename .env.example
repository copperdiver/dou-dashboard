# Copy to .env: this file is read by both docker compose and local scripts.
#   cp .env.example .env

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=dou
POSTGRES_PASSWORD=dou
POSTGRES_DB=dou_dashboard
# Port on which Postgres is exposed to the host.
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Web ───────────────────────────────────────────────────────────────────
# Port on which Next.js is exposed to the host.
WEB_PORT=3000

# Time zone. Affects how stats are grouped by day in Postgres.
TZ=Europe/Moscow

# Public site URL with no trailing slash. Only needed for canonical links
# and hreflang in meta tags; without it they're simply omitted, so
# localhost addresses never end up in the markup.
# SITE_URL=https://example.org

# Microsoft Clarity. Without it the tracking script isn't loaded at all.
# Local runs shouldn't send data into the same project as production.
# CLARITY_ID=

# Proxy for requests to in.gov.br ONLY. Needed if the server's IP is
# blocked by the source. We don't enable the proxy via Node's environment
# variables, since that would also route LLM traffic through it, and LLM
# traffic is billed by the gigabyte just like the proxy.
# DOU_PROXY_URL=http://user:password@host:port

# ── Connections for LOCAL runs (npm run dev / npm run worker) ─────────────
# Inside docker compose these values are overridden to the postgres/redis hosts.
DATABASE_URL=postgres://dou:dou@localhost:5432/dou_dashboard
REDIS_URL=redis://localhost:6379

# ── Source: in.gov.br ──────────────────────────────────────────────────────
# With the default UA (node, python-urllib) the source responds with 403.
# A browser User-Agent is required.
# DOU_USER_AGENT=
# Minimum interval between requests. Best not to go below 1000 ms.
DOU_MIN_INTERVAL_MS=2000
# Hard daily request cap (a safeguard against an endless loop).
DOU_MAX_REQUESTS_PER_DAY=5000
# Queue pause after a 403 and after a streak of 403s.
DOU_FORBIDDEN_COOLDOWN_MS=900000
DOU_FORBIDDEN_STREAK_LIMIT=3
DOU_LONG_COOLDOWN_MS=3600000
# Gazette sections. Measurements showed naturalization notices only appear
# in do1; do2/do3/do1e are empty.
DOU_SECTIONS=do1

# ── Pipeline ────────────────────────────────────────────────────────────────
# How far back discover looks: DOU publishes with a delay and amends editions.
DISCOVER_LOOKBACK_DAYS=7
# Batch size per pump tick.
ENUMERATE_BATCH=5
# How many hours to wait before retrying a day whose index is empty, while
# that day hasn't ended yet in Sao Paulo time. The edition comes out in the
# morning but polling starts at night: an empty index for the current day
# is normal, not "no edition was published."
ENUMERATE_EMPTY_RETRY_HOURS=3
FETCH_BATCH=10
# Attempts per day/page before marking it failed.
INGEST_MAX_ATTEMPTS=5
# Lease on a claimed row: once expired, it can be claimed again.
INGEST_CLAIM_LEASE_MS=300000
# Default backfill depth for npm run backfill.
BACKFILL_DAYS=365

# ── LLM: denial reason enrichment ──────────────────────────────────────────
# auto | claude | openai | noop
#
# auto (default): claude if ANTHROPIC_API_KEY is set; otherwise openai if
# OPENAI_API_KEY is set; otherwise a no-op stub. Without keys the pipeline
# runs on the stub instead of failing. Ingestion and parsing don't depend
# on the LLM.
#
# An explicitly set provider without its key is a configuration error; the
# worker reports it immediately instead of silently falling back to the stub.
LLM_PROVIDER=auto

# ── Keys. Keep real values in .env, which is gitignored ────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# The model is set separately per provider: a shared variable would end up
# pointed at the wrong API when switching providers and return a 404 there.
# Defaults are claude-opus-5 and gpt-5.2 (the same quality tier), so
# results from the two providers are comparable.
# Cheaper: claude-haiku-4-5 / gpt-5-mini.
# LLM_MODEL_CLAUDE=claude-opus-5
# LLM_MODEL_OPENAI=gpt-5.2

# ── Worker ──────────────────────────────────────────────────────────────────
# The fetch queue always runs at concurrency 1. This is a courtesy to the source.
WORKER_CONCURRENCY=2
WORKER_LLM_CONCURRENCY=1
