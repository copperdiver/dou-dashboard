# Скопируйте в .env — файл читают и docker compose, и локальные скрипты.
#   cp .env.example .env

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=dou
POSTGRES_PASSWORD=dou
POSTGRES_DB=dou_dashboard
# Порт, на котором Postgres виден с хоста.
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── Web ───────────────────────────────────────────────────────────────────
# Порт, на котором Next.js виден с хоста.
WEB_PORT=3000

# Часовой пояс. Влияет на группировку статистики по суткам в Postgres.
TZ=Europe/Moscow

# ── Подключения для ЛОКАЛЬНОГО запуска (npm run dev / npm run worker) ─────
# Внутри docker compose эти значения перезаписываются на хосты postgres/redis.
DATABASE_URL=postgres://dou:dou@localhost:5432/dou_dashboard
REDIS_URL=redis://localhost:6379

# ── Источник: in.gov.br ───────────────────────────────────────────────────
# С UA по умолчанию (node, python-urllib) источник отвечает 403 —
# браузерный User-Agent обязателен.
# DOU_USER_AGENT=
# Минимальный интервал между запросами. Ниже 1000 мс лучше не опускать.
DOU_MIN_INTERVAL_MS=2000
# Жёсткий потолок запросов в сутки — страховка от бесконечного цикла.
DOU_MAX_REQUESTS_PER_DAY=5000
# Пауза очереди после 403 и после серии 403.
DOU_FORBIDDEN_COOLDOWN_MS=900000
DOU_FORBIDDEN_STREAK_LIMIT=3
DOU_LONG_COOLDOWN_MS=3600000
# Секции выпуска. Замер показал, что публикации о натурализации есть
# только в do1; do2/do3/do1e пусты.
DOU_SECTIONS=do1

# ── Конвейер ──────────────────────────────────────────────────────────────
# Насколько назад смотрит discover: DOU публикует с задержкой и правит выпуски.
DISCOVER_LOOKBACK_DAYS=7
# Размер пачки за один тик насоса.
ENUMERATE_BATCH=5
FETCH_BATCH=10
# Попыток на день/страницу до статуса failed.
INGEST_MAX_ATTEMPTS=5
# Аренда взятой в работу строки: истекла — можно взять заново.
INGEST_CLAIM_LEASE_MS=300000
# Глубина бэкфилла по умолчанию для npm run backfill.
BACKFILL_DAYS=365

# ── LLM: обогащение причин отказа ─────────────────────────────────────────
# auto | claude | openai | noop
#
# auto (по умолчанию): claude, если есть ANTHROPIC_API_KEY; иначе openai,
# если есть OPENAI_API_KEY; иначе заглушка. Без ключей конвейер работает
# на заглушке, а не падает — загрузка и разбор от LLM не зависят.
#
# Явно указанный провайдер без ключа — ошибка конфигурации, воркер скажет
# об этом сразу, а не подменит тихо заглушкой.
LLM_PROVIDER=auto

# ── Ключи. Настоящие значения держите в .env, он в .gitignore ─────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Модель задаётся отдельно на провайдера: общая переменная при
# переключении провайдера уехала бы в чужой API и дала бы там 404.
# По умолчанию claude-opus-5 и gpt-5.2 — один уровень качества,
# чтобы результаты двух провайдеров были сравнимы.
# Дешевле: claude-haiku-4-5 / gpt-5-mini.
# LLM_MODEL_CLAUDE=claude-opus-5
# LLM_MODEL_OPENAI=gpt-5.2

# ── Воркер ────────────────────────────────────────────────────────────────
# Очередь fetch всегда concurrency 1 — это вежливость к источнику.
WORKER_CONCURRENCY=2
WORKER_LLM_CONCURRENCY=1
