# Production environment. Copy to the server as .env next to
# docker-compose.prod.yml:
#
#   cp .env.production.example .env
#
# Values with no default are required: compose refuses to start
# without them instead of quietly falling back to a default nobody
# remembers setting.

# ── Images ───────────────────────────────────────────────────────────────
# The tag changes on deploy and rollback. latest tracks the newest build
# of the main branch; for predictable deploys, pin a release tag
# (v1.4.0) or a full commit sha instead.
IMAGE_PREFIX=ghcr.io/your-org/dou-dashboard
IMAGE_TAG=latest

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=dou
# REQUIRED. A default password on a server is not acceptable.
POSTGRES_PASSWORD=
POSTGRES_DB=dou_dashboard

# Timezone. Affects how daily stats are grouped in Postgres.
TZ=Europe/Moscow

# ── Web ───────────────────────────────────────────────────────────────────
# Domain that Traefik routes requests for. SITE_URL for canonical links
# and hreflang is derived from it, so there's no separate variable for
# the address, since there's no reason to let the two drift apart.
# No port is published externally: Traefik sits in front.
PUBLIC_HOST=example.com

# Microsoft Clarity: behavior analytics. Empty means the tracker isn't loaded.
CLARITY_ID=

# Proxy used only for requests to in.gov.br. Empty means direct requests.
# Needed when the source blocks the server's address.
DOU_PROXY_URL=

# ── Source: in.gov.br ───────────────────────────────────────────────────────
# REQUIRED. The default UA (node, python-urllib) gets a 403 from the
# source, so a browser User-Agent is required.
DOU_USER_AGENT=
# Minimum interval between requests. Best not to go below 1000ms.
DOU_MIN_INTERVAL_MS=2000
# Hard daily request ceiling: a safeguard against a runaway loop.
DOU_MAX_REQUESTS_PER_DAY=5000
# Gazette sections: naturalization notices only appear in do1.
DOU_SECTIONS=do1

# ── Pumps ─────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_LLM_CONCURRENCY=1
DISCOVER_LOOKBACK_DAYS=7
ENUMERATE_BATCH=5
# How many hours to wait before retrying a day whose index came back
# empty, while that day hasn't ended yet in São Paulo time. The edition
# is published in the morning but polling starts at night: an empty
# index for the current day is normal, not "no edition."
ENUMERATE_EMPTY_RETRY_HOURS=3
FETCH_BATCH=10
BACKFILL_DAYS=365

# ── LLM ───────────────────────────────────────────────────────────────────
# auto picks whichever provider has a key set. Without keys, denial
# reasons stay in the original Portuguese with no category assigned.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
