# Окружение продакшена. Скопировать на сервер как .env рядом
# с docker-compose.prod.yml:
#
#   cp .env.production.example .env
#
# Значения без умолчаний обязательны — compose откажется стартовать
# без них, а не поднимется с дефолтом, о котором никто не помнит.

# ── Образы ────────────────────────────────────────────────────────────────
# Тег меняется при выкладке и откате. latest берёт последнюю сборку
# основной ветки; для предсказуемых выкладок лучше ставить тег релиза
# (v1.4.0) или полный sha коммита.
IMAGE_PREFIX=ghcr.io/copperdiver/dou-dashboard
IMAGE_TAG=latest

# ── Postgres ──────────────────────────────────────────────────────────────
POSTGRES_USER=dou
# ОБЯЗАТЕЛЬНО. Пароль по умолчанию на сервере недопустим.
POSTGRES_PASSWORD=
POSTGRES_DB=dou_dashboard

# Часовой пояс. Влияет на группировку статистики по суткам в Postgres.
TZ=Europe/Moscow

# ── Web ───────────────────────────────────────────────────────────────────
# Домен, по которому Traefik маршрутизирует запросы. Из него же
# собирается SITE_URL для канонических ссылок и hreflang, поэтому
# отдельной переменной для адреса нет — расходиться им незачем.
# Портов наружу не публикуется: снаружи стоит Traefik.
PUBLIC_HOST=dou.copperdiver.studio

# ── Источник: in.gov.br ───────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО. С UA по умолчанию (node, python-urllib) источник отвечает
# 403 — нужен браузерный User-Agent.
DOU_USER_AGENT=
# Минимальный интервал между запросами. Ниже 1000 мс лучше не опускать.
DOU_MIN_INTERVAL_MS=2000
# Жёсткий потолок запросов в сутки — страховка от бесконечного цикла.
DOU_MAX_REQUESTS_PER_DAY=5000
# Секции выпуска: публикации о натурализации есть только в do1.
DOU_SECTIONS=do1

# ── Насосы ────────────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_LLM_CONCURRENCY=1
DISCOVER_LOOKBACK_DAYS=7
ENUMERATE_BATCH=5
FETCH_BATCH=10
BACKFILL_DAYS=365

# ── LLM ───────────────────────────────────────────────────────────────────
# auto — берётся тот провайдер, чей ключ задан. Без ключей причины
# отказа остаются с португальским оригиналом и без категории.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
