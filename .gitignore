node_modules/
.next/
out/
build/
dist/

# env: игнорируется всё семейство, кроме шаблона.
# Шире, чем перечисление конкретных имён: резервная копия вида
# `.env.bak.1785390869` под `.env.local`/`.env.*.local` не попадала бы
# и утекла бы в коммит вместе с ключами.
.env
.env.*
# Шаблоны без значений — исключения из правила выше и перечислены
# поимённо: любой другой файл вида `.env.*` остаётся закрытым.
!.env.example
!.env.production.example

# Дампы базы. В репозитории им не место: это десятки мегабайт двоичных
# данных с именами и датами рождения людей, и из истории git их потом
# не вырезать без перезаписи.
*.dump
*.sql.gz

# логи
*.log
npm-debug.log*

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# прочее
*.tsbuildinfo
next-env.d.ts
coverage/
