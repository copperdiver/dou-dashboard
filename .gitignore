node_modules/
.next/
out/
build/
dist/

# env: ignore the whole family except the templates.
# Broader than listing specific names: a backup file like
# `.env.bak.1785390869` next to `.env.local`/`.env.*.local` wouldn't be
# caught otherwise, and would leak into a commit along with the keys.
.env
.env.*
# Templates with no real values: exceptions to the rule above, listed
# by name. Any other `.env.*` file stays ignored.
!.env.example
!.env.production.example

# Database dumps. These don't belong in the repo: tens of megabytes of
# binary data with people's names and birth dates, and once in git
# history they can't be removed without a rewrite.
*.dump
*.sql.gz

# logs
*.log
npm-debug.log*

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# misc
*.tsbuildinfo
next-env.d.ts
coverage/
